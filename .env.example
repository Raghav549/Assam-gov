# Render / backend
PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-frontend-domain.com

# Gmail SMTP OTP (set real values in Render Environment only)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Youth Assam <your-email@gmail.com>

# MongoDB - recommended for persistent OTP storage
MONGODB_URI=

# Frontend Supabase
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Optional Supabase frontend storage/auth configuration
# Supabase dashboard controls Auth, Database, Storage and Realtime.
