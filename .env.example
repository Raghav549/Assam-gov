# =============================================================
# BACKEND (Render web service) — set these in Render → Environment
# =============================================================
PORT=5000
NODE_ENV=production
# Frontend origin(s), comma separated. Trailing slashes are fine. Wildcards: https://*.vercel.app
CLIENT_URL=https://your-frontend-domain.com

# -------------------------------------------------------------
# EMAIL (verification codes, password reset, welcome mails)
# -------------------------------------------------------------
# !! Render FREE instances BLOCK outbound SMTP (ports 25/465/587). !!
# Gmail SMTP will time out there no matter how correct the password is.
# Use an HTTPS email API instead — Brevo is the easiest (free 300 emails/day,
# no domain needed: just verify your Gmail address as a sender in Brevo).
#
# auto = use every configured provider in this order, falling back on failure:
#        brevo → resend → sendgrid → gmail (API) → smtp
EMAIL_PROVIDER=auto
EMAIL_FROM=Youth Assam <indian.tx.tl@gmail.com>
# EMAIL_REPLY_TO=support@example.com

# Option A (recommended on Render free): Brevo — https://app.brevo.com → SMTP & API → API keys
BREVO_API_KEY=

# Option B: Resend — needs a verified domain to email anyone except yourself
RESEND_API_KEY=

# Option C: SendGrid
SENDGRID_API_KEY=

# Option D: Gmail API over HTTPS (sends from your Gmail account, works on Render free)
# Create an OAuth client in Google Cloud, enable the Gmail API, get a refresh token
# with scope https://www.googleapis.com/auth/gmail.send (see README). Publish the
# OAuth app ("In production"), otherwise Google expires the refresh token after 7 days.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Option E: SMTP (works locally and on paid hosting; blocked on Render free)
# Gmail: EMAIL_PASS must be a 16-character App Password (2-Step Verification required).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=indian.tx.tl@gmail.com
EMAIL_PASS=
# Show provider error details in API responses (keep false in production)
EMAIL_DEBUG=false

# -------------------------------------------------------------
# DATABASE — Supabase (data/storage only, NOT used for authentication)
# -------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional but needed for the dashboard's database writes to pass Row Level Security:
# Supabase → Project Settings → JWT Keys → "Legacy JWT secret".
SUPABASE_JWT_SECRET=

# -------------------------------------------------------------
# AUTH — custom JWT. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# -------------------------------------------------------------
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# =============================================================
# FRONTEND (build-time; set where the React app is built/hosted)
# =============================================================
REACT_APP_BACKEND_URL=https://youth-assam-backend.onrender.com
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
